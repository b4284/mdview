#!/usr/bin/env python3
"""mdview: tiny local Markdown + Mermaid viewer. Nothing leaves your machine.

usage: mdview [DIR_OR_FILE] [-p PORT] [--host 127.0.0.1] [--no-open] [--no-check]
"""
import argparse, html, json, mimetypes, os, re, subprocess, sys
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, unquote, urlparse

APP = os.path.dirname(os.path.realpath(__file__))  # viewer.html and node_modules live beside this script
ASSETS = os.path.join(APP, "node_modules")
SKIP = {".git", "node_modules", "__pycache__", ".venv"}


def find_up(start, names, stop):
    """Walk from `start` up to `stop` (inclusive) looking for any of `names`; returns (dir, name) or None."""
    d = start
    while True:
        for n in names:
            if os.path.isfile(os.path.join(d, n)):
                return d, n
        if d == stop or os.path.dirname(d) == d:
            return None
        d = os.path.dirname(d)


INC_RE = re.compile(r"\[!include\s*\[[^\]]*\]\(\s*([^)\s]+)[^)]*\)\s*\]", re.I)
CODE_RE = re.compile(r"\[!code-[\w#+-]+\s*\[[^\]]*\]\(\s*([^)\s]+)[^)]*\)\s*\]", re.I)
LINK_RE = re.compile(r"(!?)\[[^\]]*\]\(\s*([^)\s]+)")
FENCE_RE = re.compile(r"^\s{0,3}(`{3,}|~{3,})")


def read_markdown(path):
    """Return (text, None) or (None, reason) for a file mdview can render."""
    try:
        with open(path, "rb") as f:
            data = f.read()
    except OSError as e:
        return None, e.strerror or str(e)
    if b"\x00" in data[:8192]:
        return None, "looks like a binary file, not text"
    try:
        return data.decode("utf-8-sig"), None
    except UnicodeDecodeError as e:
        return None, f"not valid UTF-8 (byte {e.start}); re-save it as UTF-8"


def scan(path, root, problems, warnings, seen, depth=0):
    """Look for things that cannot render: unreadable files, missing includes/snippets (errors),
    and missing local images or linked .md files (warnings). Mirrors the viewer's path rules."""
    if path in seen or depth > 5:
        return
    seen.add(path)
    text, why = read_markdown(path)
    if text is None:
        problems.append(f"{path}: {why}")
        return
    here = os.path.dirname(path)
    rel = lambda p: os.path.relpath(p)

    def target(ref):
        ref = re.split(r"[?#]", ref, maxsplit=1)[0]
        if not ref or re.match(r"^([a-z][a-z0-9+.-]*:|//)", ref, re.I):
            return None
        if ref.startswith("~/") or ref.startswith("/"):
            return os.path.realpath(os.path.join(root, ref.lstrip("~").lstrip("/")))
        return os.path.realpath(os.path.join(here, ref))

    def inside(p):
        return p == root or p.startswith(root + os.sep)

    fence = None
    for n, line in enumerate(text.split("\n"), 1):
        m = FENCE_RE.match(line)
        if m and not fence:
            fence = m[1]
            continue
        if fence:
            if m and m[1][0] == fence[0] and len(m[1]) >= len(fence) and not line.strip().strip("`~"):
                fence = None
            continue
        for rx, what in ((INC_RE, "include"), (CODE_RE, "code snippet file")):
            for mm in rx.finditer(line):
                t = target(mm[1])
                if t is None:
                    continue
                if not inside(t):
                    problems.append(f"{rel(path)}:{n}: {what} {mm[1]!r} is outside the served folder")
                elif not os.path.isfile(t):
                    problems.append(f"{rel(path)}:{n}: {what} not found: {re.split(r'[?#]', mm[1], maxsplit=1)[0]}")
                elif rx is INC_RE:
                    scan(t, root, problems, warnings, seen, depth + 1)
        stripped = INC_RE.sub("", CODE_RE.sub("", line))
        for mm in LINK_RE.finditer(stripped):
            ref = mm[2]
            if ref.startswith("#") or ref.lower().startswith("xref:"):
                continue
            t = target(ref)
            if t is None:
                continue
            is_img = bool(mm[1])
            if is_img or re.search(r"\.(md|markdown)$", re.split(r"[?#]", ref, maxsplit=1)[0], re.I):
                if not inside(t) or not os.path.exists(t):
                    warnings.append(f"{rel(path)}:{n}: {'image' if is_img else 'linked page'} not found: {ref}")


class H(SimpleHTTPRequestHandler):
    root = os.getcwd()

    def log_message(self, *a):  # quiet
        pass

    def do_POST(self):
        """The viewer reports render problems (bad diagram, missing include, script error) here."""
        if urlparse(self.path).path != "/__report":
            return self._send(404, "not found", "text/plain")
        try:
            n = min(int(self.headers.get("Content-Length", 0)), 4096)
        except ValueError:
            n = 0
        msg = self.rfile.read(n).decode("utf-8", "replace")
        msg = "".join(c if c.isprintable() else " " for c in msg)[:500]
        print(f"mdview: warning: {msg}", file=sys.stderr, flush=True)
        self.send_response(204)
        self.end_headers()

    def _send(self, code, body, ctype="text/html; charset=utf-8"):
        if isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def _file(self, path):
        try:
            with open(path, "rb") as f:
                data = f.read()
        except OSError:
            return self._send(404, "not found", "text/plain")
        ctype = mimetypes.guess_type(path)[0] or "application/octet-stream"
        if ctype.startswith("text/") or ctype in ("application/javascript", "application/json"):
            ctype += "; charset=utf-8"
        self._send(200, data, ctype)

    def _safe(self, base, rel):
        p = os.path.realpath(os.path.join(base, rel))
        return p if p == base or p.startswith(base + os.sep) else None

    def do_GET(self):
        u = urlparse(self.path)
        q = parse_qs(u.query)
        path = unquote(u.path)

        if path.startswith("/__assets/"):
            p = self._safe(ASSETS, path[len("/__assets/"):])
            return self._file(p) if p else self._send(403, "forbidden", "text/plain")

        if path == "/" and "f" in q:
            return self._file(os.path.join(APP, "viewer.html"))

        if path == "/__info":
            return self._info(q.get("f", [""])[0])

        p = self._safe(self.root, path.lstrip("/"))
        if not p:
            return self._send(403, "forbidden", "text/plain")

        if os.path.isdir(p):
            return self._index(p)

        if p.lower().endswith((".md", ".markdown")) and "raw" not in q:
            rel = os.path.relpath(p, self.root)
            self.send_response(302)
            self.send_header("Location", "/?f=" + rel.replace(os.sep, "/"))
            self.end_headers()
            return
        return self._file(p)

    def _info(self, f):
        """DocFX hints for a file: the docfx.json directory (for `~/` links) and the nearest toc.yml."""
        p = self._safe(self.root, f)
        d = os.path.dirname(p) if p else None
        info = {"docfxRoot": "", "toc": None}
        if d:
            hit = find_up(d, ["docfx.json"], self.root)
            if hit:
                r = os.path.relpath(hit[0], self.root)
                info["docfxRoot"] = "" if r == "." else r.replace(os.sep, "/")
            hit = find_up(d, ["toc.yml", "toc.yaml"], self.root)
            if hit:
                info["toc"] = os.path.relpath(os.path.join(*hit), self.root).replace(os.sep, "/")
        self._send(200, json.dumps(info), "application/json")

    def _index(self, d):
        rel = os.path.relpath(d, self.root)
        rel = "" if rel == "." else rel
        rows = []
        if rel:
            rows.append(f'<li><a href="/{html.escape(os.path.dirname(rel))}">..</a></li>')
        try:
            names = sorted(os.listdir(d), key=str.lower)
        except OSError:
            names = []
        for n in names:
            if n in SKIP or n.startswith("."):
                continue
            full = os.path.join(d, n)
            href = "/" + os.path.join(rel, n).replace(os.sep, "/")
            if os.path.isdir(full):
                rows.append(f'<li>📁 <a href="{html.escape(href)}">{html.escape(n)}/</a></li>')
            elif n.lower().endswith((".md", ".markdown")):
                rows.append(f'<li>📄 <a href="{html.escape(href)}">{html.escape(n)}</a></li>')
        body = f"""<!doctype html><meta charset=utf-8><title>mdview</title>
<style>body{{font:16px system-ui;max-width:700px;margin:40px auto;padding:0 16px}}
li{{list-style:none;margin:4px 0}}@media(prefers-color-scheme:dark){{body{{background:#0d1117;color:#e6edf3}}a{{color:#58a6ff}}}}</style>
<h2>/{html.escape(rel)}</h2><ul style="padding:0">{''.join(rows)}</ul>"""
        self._send(200, body)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("target", nargs="?", default=".")
    ap.add_argument("-p", "--port", type=int, default=8642)
    ap.add_argument("--host", default="127.0.0.1")
    ap.add_argument("--open", action="store_true", help="open the browser (the default; kept for compatibility)")
    ap.add_argument("--no-open", action="store_true", help="do not open a browser")
    ap.add_argument("--no-check", action="store_true", help="skip the startup checks for unreadable files and missing includes")
    a = ap.parse_args()

    if not os.path.exists(a.target):
        sys.exit(f"mdview: error: no such file or directory: {a.target}")
    target = os.path.realpath(a.target)
    start = "/"
    if os.path.isfile(target):
        # Inside a DocFX project, serve from the folder holding docfx.json so that
        # `~/` links and includes outside the article's own folder resolve.
        here = os.path.dirname(target)
        probe, hit = here, None
        for _ in range(8):
            if os.path.isfile(os.path.join(probe, "docfx.json")):
                hit = probe
                break
            if os.path.dirname(probe) == probe:
                break
            probe = os.path.dirname(probe)
        H.root = hit or here
        start = "/" + os.path.relpath(target, H.root).replace(os.sep, "/")
    else:
        H.root = target

    if not os.path.isdir(ASSETS):
        sys.exit(f"mdview: error: missing {ASSETS}; run: cd {APP} && npm install")

    if os.path.isfile(target) and not a.no_check:
        problems, warnings = [], []
        scan(target, H.root, problems, warnings, set())
        for w in warnings:
            print(f"mdview: warning: {w}", file=sys.stderr)
        if problems:
            for p in problems:
                print(f"mdview: error: {p}", file=sys.stderr)
            sys.exit(f"mdview: {len(problems)} problem(s) would stop this file rendering correctly (use --no-check to serve anyway)")

    srv = ThreadingHTTPServer((a.host, a.port), H)
    url = f"http://localhost:{a.port}{start}"
    print(f"serving {H.root}\n  {url}")
    if not a.no_open:
        for cmd in (["wslview", url], ["explorer.exe", url], ["xdg-open", url]):
            try:
                subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                break
            except FileNotFoundError:
                continue
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
